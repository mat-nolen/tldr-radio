# ── TLDR Radio config ──────────────────────────────────────────────
# Copy this file to `.env` (next to docker-compose.yml) and edit.
#
# Every setting here is OPTIONAL — docker-compose.yml has a sensible default for all of them,
# so `docker compose up -d --build` works with no .env at all. Add one when you want the
# overnight broadcast, your own timezone, or the Plex guard.
#
# `.env` is gitignored. Never commit it — PLEX_TOKEN and NTFY_URL are yours.

# ── Performance ────────────────────────────────────────────────────
# How many chapters of one episode are synthesized at once. This is the main
# speed/CPU-headroom dial.
#   • 4 is a good default on a modern 8-core machine
#   • 2 if you want the machine to stay responsive for other work
#   • 6-8 on a fast, otherwise-idle box
# Note this parallelises WITHIN an episode; editions still build one at a time.
MAX_CONCURRENT_SYNTH=4

# Hard ceiling on cores the text-to-speech container may use, independent of the setting above.
# Useful when the machine has another job to do (a media server, a build agent) and you don't
# want a broadcast to starve it.
KOKORO_CPUS=6

# ── Overnight broadcast ────────────────────────────────────────────
# 24-hour HH:MM in LOCAL time (set TZ below), e.g. 06:00 to wake up to finished episodes.
# Leave blank to disable and only broadcast by hand.
AUTO_BROADCAST_TIME=

# SEED ONLY — which newsletters run overnight is set in Settings → Stations and stored in the
# database. This line supplies the value only on the FIRST read of a fresh install, so a new
# machine comes up configured. Once you save on that page the database wins and editing this
# does nothing; change it in the UI instead.
#
# Slugs are the tldr.tech archive URL path. All 14:
#   tech  dev  ai  infosec  product  devops  founders  design
#   marketing  crypto  fintech  it  data  hardware
#
# Each is a separate job and they run one at a time, so the night scales linearly: budget a few
# minutes per edition on a fast machine, 8-15 min each on an older CPU-only box.
AUTO_BROADCAST_EDITIONS=tech,ai,infosec

# tldr.tech doesn't post at a fixed hour, and doesn't post at all on weekends or holidays. An
# edition that isn't up yet — or that failed transiently — is re-tried every ~25 min (jittered)
# for this many hours, stopping the moment it lands. Days with no issue tick by quietly and send
# no notification. Only the final state is reported, so a run that recovers never alerts you.
# 0 disables re-checking (one shot only).
AUTO_BROADCAST_RETRY_HOURS=4

# Local timezone, so AUTO_BROADCAST_TIME means local time.
#   e.g. America/New_York, America/Chicago, Europe/London, Asia/Tokyo
TZ=UTC

# ── Optional notifications ─────────────────────────────────────────
# Webhook pinged when the overnight broadcast finishes, and on failure. An ntfy topic URL works
# out of the box, e.g. https://ntfy.sh/your-private-topic . Blank disables notifications.
NTFY_URL=

# ── Optional Plex guard ────────────────────────────────────────────
# Only useful if you run this on the same machine as a Plex server: warns before a MANUAL
# broadcast if Plex is currently streaming, since transcoding and speech synthesis compete for
# the same CPU. Leave PLEX_TOKEN blank to disable the check entirely.
# From inside Docker, a Plex server on the host is reached via host.docker.internal.
# Finding your token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
