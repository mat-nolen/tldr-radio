# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime data volume (generated: SQLite db, mp3 files, cached HTML) — keep the folder, not its contents
/data/*
!/data/.gitkeep

# OS
.DS_Store
Thumbs.db

# Local env overrides
.env

# Claude Code machine-local settings — permissions and paths that accumulate per machine.
# .claude/settings.json (the shared allowlist) IS tracked on purpose; these are not.
.claude/settings.local.json
.claude/*.local.json

# Spike #0 sample audio (generated artifacts; result documented in CHANGELOG.md / docs/lessons_learned.md)
spike/*.mp3

# QA screenshots (generated by qa/qa.py)
qa/*.png

# Demo video working files. The scripts in scripts/demo_*.py are tracked; every
# artefact they produce is not — raw takes run to tens of MB, and the cards and
# the finished cut are all rebuildable from the scripts. See docs/demo-video.md.
demo/
